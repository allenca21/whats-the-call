{
  "expo": {
    "name": "What's the Call?",
    "slug": "whats-the-call",
    "version": "3.0.1",
    "orientation": "portrait",
    "icon": "./assets/images/whatsthecall.png",
    "scheme": "whatsthecall",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": false,
    "ios": {
      "supportsTablet": true,
      "icon": "./assets/images/whatsthecall.png",
      "bundleIdentifier": "com.allenca21.whatsthecall",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/whatsthecall.png",
        "backgroundColor": "#1d4ed8"
      },
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false,
      "package": "com.allenca21.whatsthecall"
    },
    "web": {
      "output": "single",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/whatsthecall.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#ffffff",
          "dark": {
            "backgroundColor": "#000000"
          }
        }
      ]
    ],
    "extra": {
      "eas": {
        "projectId": "b7758527-e184-4835-9c4a-8c645b2ef477"
      }
    }
  }
}
